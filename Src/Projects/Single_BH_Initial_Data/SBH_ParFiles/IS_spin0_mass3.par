#### a single isotropc Schwarzchild BH for test purposes

#-----------------------------------------------------------------------#
# Project:                                                              #
#-----------------------------------------------------------------------#
Project       = single_bh_initial_data
SBH_start_off = parameter_file

#-----------------------------------------------------------------------#
# Physics:                                                              #
#-----------------------------------------------------------------------#

#### system:
SYS_initialize        = one_exact_IsoSchild
SYS_initialize_fields = XCTS

#### BH:
BH_irreducible_mass  = 3
BH_start_off         = IsoSchild
BH_surface_type      = perfect_s2
BH_surface_Ylm_max_l = 15

#### ADM:
adm_constraints_method     = from_scratch,from_identities
adm_B1I_form               = zero
adm_compute_adm_Kuu_method = use_AIJ
adm_compute_AConfIJ        = SCTT_MConfIJ0

### stress energy tensor
Tij_NS_decomposition = XCTS
Tij_NS_gConf         = general

### checkpoint
checkpoint_every = never#0h
checkpoint_save  = psi

### free data
Free_data_conformal_metric             = IsoSchild
Free_data_conformal_Christoffel_symbol = IsoSchild
Free_data_conformal_Ricci              = IsoSchild
Free_data_trK                          = IsoSchild


#-----------------------------------------------------------------------#
# Grid and Geometry:                                                    #
#-----------------------------------------------------------------------#
grid_kind                    = SplitCubedSpherical(BH)
grid_set_BH                  = center,excised
grid_central_box_length      = 1
grid_box_length_ratio_BH     = 0.5
grid_around_box_length       = 20
grid_outermost_radius        = 1E5
grid_verbose                 = no
#### resolutions:

#grid_SplitCS_max_n_a         = 100
#grid_SplitCS_max_n_b         = 100
#grid_SplitCS_max_n_c         = 100
#n_a                          = 10->15->20->25->30->35->40
#n_b                          = 10->15->20->25->30->35->40
#n_c                          = 10->15->20->25->30->35->40

grid_SplitCS_max_n_a         = 5->10->15->20->25->30
grid_SplitCS_max_n_b         = 5->10->15->20->25->30
grid_SplitCS_max_n_c         = 5->10->15->20->25->30
n_a                          = 10->15->20->25->30
n_b                          = 10->15->20->25->30
n_c                          = 10->15->20->25->30

#-----------------------------------------------------------------------#
# Solve Settings and Methods:                                         #
#-----------------------------------------------------------------------#
SBH_skip_eq_solve                   = yes
solve_Order                         = alpha
solve_Newton_Update_Weight          = 1.0
solve_Residual                      = 1E-20
solve_Max_Iteration                 = 1
solve_Max_Newton_Step               = 1
solve_Method                        = DDM_Schur_Complement
Derivative_Method                   = Spectral
Interpolation_Method                = Spectral
Fourier_Transformation_Method       = RFT 
dF/du_for_Newton_Method             = Spectral 

#-----------------------------------------------------------------------#
# Print:                                                                #
#-----------------------------------------------------------------------#

txt_output_0d  = ham,mom
silo_output_3d = ham.+,mom.+,Ricci,^dpsi_D,psi

#-----------------------------------------------------------------------#
# The End                                                               #
#-----------------------------------------------------------------------#
