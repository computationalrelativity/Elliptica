#### a single black hole of conformal Kerr-Schild for test purpose.

#-----------------------------------------------------------------------#
# Project:                                                              #
#-----------------------------------------------------------------------#
Project       = single_bh_initial_data
SBH_start_off = parameter_file
SBH_boost_x   = 0.
SBH_boost_y   = 0.
SBH_boost_z   = 0.

#-----------------------------------------------------------------------#
# Physics:                                                              #
#-----------------------------------------------------------------------#

#### system:
SYS_initialize        = one_exact_ConfKerrSchild
SYS_initialize_fields = XCTS

#### BH:
BH_irreducible_mass    = 4.
BH_chi_x               = 0
BH_chi_y               = 0
BH_chi_z               = 0.
BH_boost_Vx            = 0.
BH_boost_Vy            = 0.
BH_boost_Vz            = 0.
BH_Omega_x             = 0.
BH_Omega_y             = 0.
BH_Omega_z             = 0.

BH_start_off           = KerrSchild
BH_surface_type        = KerrSchild_s2
BH_surface_Ylm_max_l   = 15
BH_Eq_inner_BC_fields  = XCTS
BH_Eq_inner_BC_alpha   = exact_ConfKerrSchild
BH_Eq_inner_BC_beta    = exact_ConfKerrSchild

#### ADM:
ADM_constraints_method     = from_scratch,from_identities
ADM_B1I_form               = zero
ADM_compute_adm_Kuu_method = use_AIJ#use_Kij

### stress energy tensor:
Tij_NS_decomposition = XCTS
Tij_NS_gConf         = general

### free data
Free_data_conformal_metric             = ConfKerrSchild
Free_data_conformal_Christoffel_symbol = ConfKerrSchild
Free_data_conformal_Ricci              = ConfKerrSchild
Free_data_trK                          = KerrSchild

### root finder:
BH_RootFinder_Tolerance = 1E-9
BH_RootFinder_Iteration = 1000
BH_RootFinder_verbose   = yes

#-----------------------------------------------------------------------#
# Settings:                                                             #
#-----------------------------------------------------------------------#

### checkpoint:
checkpoint_every = 0h
checkpoint_save  = psi

#### basics:
Derivative_Method               = Spectral
Interpolation_Method            = Spectral
Fourier_Transformation_Method   = RFT 
dF/du_for_Newton_Method         = Spectral 

#-----------------------------------------------------------------------#
# Grid and Geometry:                                                    #
#-----------------------------------------------------------------------#
grid_kind                    = SplitCubedSpherical(BH)
grid_set_BH                  = center,excised
grid_central_box_length      = 1
grid_box_length_ratio_BH     = 0.5
grid_around_box_length       = 40
grid_outermost_radius        = 1E5
grid_verbose                 = no
#### resolutions:
n_a                          = 10->15->20->25->30->35
n_b                          = 10->15->20->25->30->35
n_c                          = 10->15->20->25->30->35
grid_SplitCS_max_n_a         = 100
grid_SplitCS_max_n_b         = 100
grid_SplitCS_max_n_c         = 100

#grid_SplitCS_max_n_a         = 5->10->15->20->25
#grid_SplitCS_max_n_b         = 5->10->15->20->25
#grid_SplitCS_max_n_c         = 5->10->15->20->25
#n_a                          = 10->20->30->40->50
#n_b                          = 10->20->30->40->50
#n_c                          = 10->20->30->40->50

#-----------------------------------------------------------------------#
# Equations and Solve:                                                  #
#-----------------------------------------------------------------------#
#### what and where to solve:
Eq_type                         = Elliptic
Eq_elliptic_test                = yes
Eq_psi                          = XCTS_curve_excision_Type1_DDM, .*
Eq_alphaPsi                     = XCTS_curve_excision_Type1_DDM, .*
Eq_B0_U0                        = XCTS_curve_excision_Type1_DDM, .*
Eq_B0_U1                        = XCTS_curve_excision_Type1_DDM, .*
Eq_B0_U2                        = XCTS_curve_excision_Type1_DDM, .*
Eq_update_method                = relaxed_scheme
Eq_update_weight_psi            = 0.2
Eq_update_weight_alphaPsi       = 0.2
Eq_update_weight_B0_U0          = 0.2
Eq_update_weight_B0_U1          = 0.2
Eq_update_weight_B0_U2          = 0.2

#### how to solve:
solve_Order                     = psi,alphaPsi,B0_U0,B0_U1,B0_U2
solve_Newton_Update_Weight      = 1.0
solve_residual                  = 1E-20
solve_residual_factor           = 1E-20
solve_Max_Iteration             = 200
solve_Max_Newton_Step           = 1
solve_Method                    = DDM_Schur_Complement
solve_UMFPACK_refinement_step   = 0
solve_UMFPACK_size              = 0

#-----------------------------------------------------------------------#
# Print:                                                                #
#-----------------------------------------------------------------------#

txt_output_0d  = ham,mom,^.*_eq_residual
silo_output_3d = psi,ham.+,mom.+,Ricci,^trK,

#-----------------------------------------------------------------------#
# The End                                                               #
#-----------------------------------------------------------------------#
