#-----------------------------------------------------------------------#
# Physics:                                                              #
#-----------------------------------------------------------------------#
## NOTE: this is a low cost resolution (converging, of course) 
## but need to be tested by evolution.

#### Project:
Project = BH_BH_binary_initial_data

#### BH-BH binary:
BHBH_separation                  = 55.
BHBH_angular_velocity            = auto
BHBH_start_off                   = parameter_file
BHBH_observe_ADM_P               = S_obj1+S_obj2,default
BHBH_observe_ADM_J               = S_obj1+S_obj2,default
BHBH_P_ADM_control_method        = adjust(x_CM,y_CM)
BHBH_P_ADM_control_update_weight = 0.(x10)->0.2
BHBH_P_ADM_control_tolerance     = 1E-8
BHBH_P_ADM_control_threshold     = 10

#### BH1:
BH1_irreducible_mass        = 7.0
BH1_chi_x                   = 0.
BH1_chi_y                   = 0.
BH1_chi_z                   = 0.
BH1_boost_Vx                = off
BH1_Eq_inner_BC_fields      = XCTS
BH1_Eq_inner_BC_beta        = alpha+Omega*r
BH1_Eq_inner_BC_alpha       = none
BH1_start_off               = IsoSchild
BH1_surface_type            = perfect_s2
BH1_surface_Ylm_max_l       = 1
BH1_tune_BH_radius_criteria = fix_irreducible_mass
BH1_mass_tolerance          = 1E-8
BH1_radius_update_weight    = 0.(x10)->0.2(x390)->0.0
BH1_spin_update_weight      = 0.(x10)->0.2(x390)->0.0
BH1_spin_tolerance          = 1E-3

#### BH2:
BH2_irreducible_mass        = 7.0
BH2_chi_x                   = 0.
BH2_chi_y                   = 0.
BH2_chi_z                   = 0.
BH2_boost_Vx                = off
BH2_Eq_inner_BC_fields      = XCTS
BH2_Eq_inner_BC_beta        = alpha+Omega*r
BH2_Eq_inner_BC_alpha       = none
BH2_start_off               = IsoSchild
BH2_surface_type            = perfect_s2
BH2_surface_Ylm_max_l       = 1
BH2_tune_BH_radius_criteria = fix_irreducible_mass
BH2_mass_tolerance          = 1E-8
BH2_radius_update_weight    = 0.(x10)->0.2(x390)->0.0
BH2_spin_update_weight      = 0.(x10)->0.2(x390)->0.0
BH2_spin_tolerance          = 1E-3


#### system:
SYS_initialize        = IsoSchild+IsoSchild
SYS_initialize_fields = XCTS

#### free data
Free_data_conformal_metric             = flat
Free_data_conformal_Christoffel_symbol = flat
Free_data_conformal_Ricci              = flat
Free_data_trK                          = zero

#### ADM:
ADM_constraints_method     = from_scratch
ADM_B1I_form               = inspiral
ADM_compute_adm_Kuu_method = use_AIJ

#### stress energy tensor:
#Tij_NS_decomposition = XCTS
#Tij_NS_gConf         = general

#-----------------------------------------------------------------------#
# Settings:                                                             #
#-----------------------------------------------------------------------#

#### checkpoint:
checkpoint_every = 0h

#### basics:
Derivative_Method               = Spectral
Interpolation_Method            = Spectral
Fourier_Transformation_Method   = RFT 
dF/du_for_Newton_Method         = Spectral 

#-----------------------------------------------------------------------#
# Grid and Geometry:                                                    #
#-----------------------------------------------------------------------#

#### grid:
grid_kind                    = SplitCubedSpherical(BH+BH)
grid_set_BH1                 = left,excised
grid_set_BH2                 = right,excised
grid_BH1_central_box_length  = auto # ~ 20% of BH isotropic radius
grid_BH2_central_box_length  = auto # ~ 20% of BH isotropic radius
grid_outermost_radius        = 1E5
grid_verbose                 = no

#### resolutions:
n_a = 8(x200) ->10(x100)->12(x50)->14(x50)->16(x50)#->18(x50)->20(x40)->22(x40)
n_b = 8(x200) ->10(x100)->12(x50)->14(x50)->16(x50)#->18(x50)->20(x40)->22(x40)
n_c = 12(x200)->14(x100)->16(x50)->18(x50)->20(x50)#->22(x50)->24(x40)->26(x40)

grid_SplitCS_max_n_a = 400
grid_SplitCS_max_n_b = 400
grid_SplitCS_max_n_c = 400

#-----------------------------------------------------------------------#
# Equations and Solve:                                                  #
#-----------------------------------------------------------------------#

#### what and where to solve:
Eq_type                         = Elliptic
Eq_elliptic_test                = no
Eq_psi                          = XCTS_curve_excision_Type1_DDM, .*
Eq_alphaPsi                     = XCTS_curve_excision_Type2_DDM, .*
Eq_B0_U0                        = XCTS_flat_excision_Type1_DDM , .*
Eq_B0_U1                        = XCTS_flat_excision_Type1_DDM , .*
Eq_B0_U2                        = XCTS_flat_excision_Type1_DDM , .*
Eq_update_method                = relaxed_scheme
Eq_update_weight_psi            = 0.2
Eq_update_weight_alphaPsi       = 0.2
Eq_update_weight_B0_U0          = 0.2
Eq_update_weight_B0_U1          = 0.2
Eq_update_weight_B0_U2          = 0.2

#### solve settings:
solve_Order                     = psi,alphaPsi,B0_U0,B0_U1,B0_U2
solve_Newton_Update_Weight      = 1.
solve_residual                  = 1E-10
solve_residual_factor           = 1E-5
solve_Max_Iteration             = 1
solve_Max_Newton_Step           = 1
solve_Method                    = DDM_Schur_Complement
solve_UMFPACK_refinement_step   = 0
solve_UMFPACK_size              = 1

#-----------------------------------------------------------------------#
# Print:                                                                #
#-----------------------------------------------------------------------#

#### outputs: (regular expression is supported)
txt_output_0d  = ham,mom,eq_residual

#txt_output_1d  = ^phi, ^psi, ^alphaPsi, ^B0, ^beta, eq_residual,\
#                ham, mom, enthalpy, rho0, ^drho0_D.,\
#                d+phi_D.+, d+psi_D.+, d+alphaPsi_D.+, d+B._U.D.+

## lines separated with ',' and the fix values take place in [0,1]x[0,1]
#txt_output_1d_line = (X,0.5,0.5),(0.5,Y,0.5),(0.5,0.5,Z)



#-----------------------------------------------------------------------#
# The End                                                               #
#-----------------------------------------------------------------------#
